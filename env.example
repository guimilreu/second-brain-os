MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/second-brain-os
AUTH_SECRET=troque-por-uma-chave-com-no-minimo-32-caracteres
# debug | info | warn | error (padrão: debug em dev, info em produção)
LOG_LEVEL=debug
# true | false — log de queries Mongoose no console (padrão: ativo em dev)
MONGOOSE_DEBUG=true

# Build (opcional)
# NEXT_TELEMETRY_DISABLED=1
# NODE_OPTIONS=--max-old-space-size=8192
BOOTSTRAP_NAME=GM
BOOTSTRAP_EMAIL=voce@email.com
BOOTSTRAP_PASSWORD=uma-senha-forte
